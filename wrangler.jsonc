{
  "name": "snapscore",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./docs",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [{ "name": "STORE", "class_name": "ScoreStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ScoreStore"] }]
}
